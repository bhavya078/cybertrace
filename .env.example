# ==============================================================================
# CyberTrace Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# DO NOT commit real API keys or credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistence Adapter Configuration
# Options: "file" (default local JSON adapter in .data/cases.json) | "memory"
CYBERTRACE_STORAGE_ADAPTER=file

# AI Service Adapters Mode
# Options: "mock" (default safe deterministic mock) | "nebius_nvidia"
CYBERTRACE_AI_MODE=mock

# ==============================================================================
# Future NVIDIA / Nebius Token Factory Integrations (Placeholder only)
# See docs/model-integration-guide.md for setup instructions
# ==============================================================================
NEBIUS_API_KEY=your_nebius_token_factory_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NVIDIA_FORENSIC_MODEL=nvidia/nemotron-forensic-vision-v1
NVIDIA_TRACE_EMBEDDING_MODEL=nvidia/nv-embed-multimodal-v1
NVIDIA_GUARDIAN_LLM=nvidia/nemotron-4-340b-instruct
